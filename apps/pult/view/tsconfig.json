{
  // apps/web's settings, which its code and the view's are written to; its `paths` resolve from apps/web.
  "extends": "../../web/tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    // The page's program (`../tsconfig.json`) reads the view through its declarations, so the
    // view and apps/web's source are checked once, with apps/web's settings; a composite
    // project lists every file it reaches.
    "composite": true,
    "rootDir": "../..",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "../node_modules/.cache/view-types"
  },
  "include": [".", "../../web/src"],
  "exclude": ["../../web/src/**/*.test.ts", "../../web/src/**/*.test.tsx"]
}
