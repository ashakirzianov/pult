{
  "workbench.colorTheme": "Dark 2026",
  "workbench.preferredDarkColorTheme": "Dark 2026",
  "workbench.preferredLightColorTheme": "Light 2026",
  "workbench.colorCustomizations": {
    "[Light 2026]": {
      "list.hoverBackground": "#0000000D",
      "list.activeSelectionBackground": "#00000017",
      "list.inactiveSelectionBackground": "#00000017",
      "list.focusBackground": "#00000017",
      "quickInputList.focusBackground": "#00000017",
      "quickInputList.focusForeground": "#202020",
      "quickInputList.focusIconForeground": "#202020",
      "quickInputList.focusHighlightForeground": "#0056A8",
      "menu.selectionBackground": "#00000012",
      "menu.selectionBorder": "#0069CC80",
      "editorSuggestWidget.selectedBackground": "#00000017",
      "toolbar.hoverBackground": "#0000000D",
      "toolbar.activeBackground": "#00000017",
      "tab.activeBorderTop": "#00000099"
    },
    "[Dark 2026]": {
      "list.hoverBackground": "#FFFFFF0D",
      "list.activeSelectionBackground": "#FFFFFF17",
      "list.inactiveSelectionBackground": "#FFFFFF17",
      "list.focusBackground": "#FFFFFF17",
      "quickInputList.focusBackground": "#FFFFFF17",
      "quickInputList.focusForeground": "#BFBFBF",
      "quickInputList.focusIconForeground": "#BFBFBF",
      "quickInputList.focusHighlightForeground": "#65B6DB",
      "menu.selectionBackground": "#FFFFFF12",
      "menu.selectionBorder": "#3994BC99",
      "editorSuggestWidget.selectedBackground": "#FFFFFF17",
      "toolbar.hoverBackground": "#FFFFFF0D",
      "toolbar.activeBackground": "#FFFFFF17",
      "tab.activeBorderTop": "#3994BCB3"
    }
  },
  "workbench.iconTheme": "vs-seti",
  "workbench.startupEditor": "none",
  "workbench.editor.useModal": "off",
  "workbench.tips.enabled": false,
  "workbench.activityBar.location": "hidden",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.statusBar.visible": false,
  "workbench.layoutControl.enabled": false,
  "window.commandCenter": false,
  "window.menuBarVisibility": "hidden",
  "window.titleBarStyle": "custom",
  "window.customTitleBarVisibility": "never",
  "breadcrumbs.enabled": false,
  "editor.minimap.enabled": false,
  "editor.scrollBeyondLastLine": false,
  "editor.fontSize": 13,
  "editor.wordWrap": "bounded",
  "editor.wordWrapColumn": 80,
  "files.autoSave": "off",
  "security.workspace.trust.enabled": false,
  "extensions.ignoreRecommendations": true,
  "update.mode": "none",
  "telemetry.telemetryLevel": "off"
}
